# Copie ce fichier en .env et remplis tes vraies valeurs.
# Ne commit JAMAIS le fichier .env (voir .gitignore).

# Clés API Binance — génère-les sur binance.com (ou testnet.binance.vision pour tester)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = testnet (argent fictif, pour tester sans risque) / false = compte réel
USE_TESTNET=true

# Paire tradée
SYMBOL=BTC/USDT

# Capital max engagé par ordre, en devise de cotation (ex: USDT)
MAX_ORDER_SIZE=50

# Perte max acceptée par position avant coupure automatique (en %)
STOP_LOSS_PCT=2.0

# Turso (libSQL distant) pour la persistance d'état — survit aux redéploiements Render.
# Laisse vide pour revenir au fichier local state.json (dev local).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
